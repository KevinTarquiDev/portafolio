# Copia este archivo a .env y completa los valores reales.
# .env nunca se commitea (ver .gitignore).

# Clave de API de Brevo (Transactional > SMTP API). Sin ella, el
# formulario de contacto responde 503 (not_configured).
BREVO_API_KEY=

# Remitente verificado en Brevo (dominio o email autenticado).
CONTACT_SENDER_EMAIL=

# Nombre del remitente que verá quien reciba el correo. Opcional: si
# falta, se usa basics["x-displayName"] del resume.
CONTACT_SENDER_NAME=

# Email que recibe los mensajes del formulario. Opcional: si falta,
# se usa basics.email del resume.
CONTACT_RECIPIENT_EMAIL=

# URL de producción del sitio, usada para canonical, hreflang, sitemap
# y Open Graph. Opcional: si falta, se usa el valor por defecto
# definido en astro.config.mjs.
SITE_URL=
