---
import { Picture } from "astro:assets";
import SceneEyebrow from "./SceneEyebrow.astro";
import ecuLanding from "../assets/projects/ecustock/landing_ecustock.png";
import type { PortfolioViewModel } from "../lib/portfolio";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { portfolio, ui } = Astro.props;
const { items } = portfolio.workIntro;
---

<section id="work" data-scene-label={ui.work.eyebrow} class="scene work">
  <div class="stage">
    <div
      class="glow work-glow"
      aria-hidden="true"
      data-motion="work-glow"
    ></div>

    <SceneEyebrow
      scene="work"
      label={ui.work.eyebrow}
      as="p"
      class="eyebrow"
      data-motion="work-meta"
    />

    <h2 class="title">
      <span class="serif selected" data-motion="work-selected">
        {ui.work.selected}
      </span>
      <span class="sr-only">Work</span>
      <span class="display word" aria-hidden="true">
        <span data-motion="work-w">W</span>
        <span class="window" data-motion="work-window">
          <Picture
            src={ecuLanding}
            formats={["avif", "webp"]}
            alt={ui.featured.captionLanding}
            class="window-media"
          />
          <span class="window-dot" data-motion="work-window-dot"></span>
        </span>
        <span data-motion="work-rk">RK</span>
      </span>
    </h2>

    <ol class="projects" data-motion="work-meta">
      {items.map((item, index) => (
        <li>
          <span
            class:list={[
              "mono-label",
              index === 0 ? "text-green" : "text-muted",
            ]}
          >
            {item.index}
          </span>
          <span
            class:list={[
              "project-name",
              index === 0 ? "text-ink" : "text-soft",
            ]}
          >
            {item.name}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ---------- Mobile · parte superior del artboard M04 ---------- */
  .work {
    height: calc(var(--u) * 520);
  }

  .stage {
    height: 100%;
  }

  .work-glow {
    left: calc(var(--ux) * -200);
    top: 0;
    width: calc(var(--u) * 590);
    height: calc(var(--u) * 700);
    --glow-strength: 32%;
  }

  .work :global(.eyebrow) {
    position: absolute;
    z-index: 6;
    left: calc(var(--ux) * 20);
    top: calc(var(--u) * 96);
  }

  .title {
    margin: 0;
  }

  .selected {
    position: absolute;
    z-index: 5;
    left: calc(var(--ux) * 18);
    top: calc(var(--u) * 122);
    font-size: calc(var(--u) * 84);
    line-height: 1;
    color: var(--color-lilac);
  }

  .word {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    top: calc(var(--u) * 224);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(var(--u) * 4);
    font-size: calc(var(--u) * 154);
    white-space: nowrap;
    color: var(--color-ink);
  }

  .window {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: calc(var(--u) * 124);
    height: calc(var(--u) * 124);
    overflow: hidden;
    border-radius: 9999px;
    background: radial-gradient(
      circle at 45% 40%,
      color-mix(in srgb, var(--color-purple) 55%, var(--color-panel)),
      var(--color-panel) 72%
    );
    box-shadow: 0 0 48px
      color-mix(in srgb, var(--color-purple) 18%, transparent);
  }

  .window :global(.window-media) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 2px solid var(--color-green);
    border-radius: 9999px;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.motion) .work {
      z-index: 2;
      overflow-x: clip;
      overflow-y: visible;
      background-color: var(--color-bg);
      pointer-events: none;
    }
  }

  .window-dot {
    display: none;
  }

  .projects {
    display: none;
  }

  /* ---------- Desktop · artboard 04 (1440×900) ---------- */
  @media (min-width: 1024px) and (min-aspect-ratio: 1/1) {
    .work {
      height: 100svh;
    }

    .stage {
      height: calc(var(--u) * 900);
    }

    .work-glow {
      left: calc(var(--ux) * 220);
      top: calc(var(--u) * -150);
      width: calc(var(--u) * 1200);
      height: calc(var(--u) * 1200);
      --glow-strength: 34%;
    }

    .work :global(.eyebrow) {
      left: calc(var(--ux) * 104);
      top: auto;
      bottom: calc(var(--u) * 120);
      z-index: 5;
    }

    .selected {
      left: calc(var(--ux) * 110);
      top: calc(var(--u) * 96);
      font-size: calc(var(--u) * 210);
    }

    .word {
      left: 0;
      right: 0;
      top: calc(var(--u) * 268);
      justify-content: center;
      gap: calc(var(--u) * 10);
      font-size: calc(var(--u) * 580);
    }

    .window {
      width: calc(var(--u) * 420);
      height: calc(var(--u) * 420);
      box-shadow: 0 0 110px
        color-mix(in srgb, var(--color-purple) 20%, transparent);
    }

    :global(html.motion) .work {
      overflow: hidden;
    }

    .window-dot {
      position: absolute;
      left: 50%;
      top: calc(var(--u) * -12);
      display: block;
      width: calc(var(--u) * 22);
      height: calc(var(--u) * 22);
      translate: -50% 0;
      border-radius: 9999px;
      background: var(--color-green);
      box-shadow: 0 0 44px
        color-mix(in srgb, var(--color-green) 50%, transparent);
    }

    .projects {
      position: absolute;
      z-index: 5;
      right: calc(var(--ux) * 210);
      bottom: calc(var(--u) * 120);
      display: flex;
      gap: calc(var(--u) * 48);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .projects li {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .project-name {
      font-size: calc(var(--u) * 28);
      font-weight: 700;
      font-stretch: 80%;
    }
  }
</style>
