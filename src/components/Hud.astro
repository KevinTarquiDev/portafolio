---
import LanguageSwitch from "./LanguageSwitch.astro";
import MobileMenu from "./MobileMenu.astro";
import type { PortfolioViewModel } from "../lib/portfolio";
import type { Locale } from "../lib/resume";
import { SCENE_TOTAL, sceneIndex } from "../lib/scenes";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  locale: Locale;
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { locale, portfolio, ui } = Astro.props;

/**
 * Estado inicial del HUD (escena 01). motion.ts actualiza índice, rótulo
 * y progreso con el scroll; sin JS se queda en la primera escena.
 */
const initialProgress = (1 / Number(SCENE_TOTAL)) * 100;

const initials = portfolio.hero.displayName
  .split(" ")
  .map((word) => word[0])
  .join("")
  .toUpperCase();

const navLinks: Array<{ href: string; label: string }> = [
  { href: "#work", label: ui.nav.work },
  { href: "#experience", label: ui.nav.experience },
  { href: "#stack", label: ui.nav.stack },
  { href: "#contact", label: ui.nav.contact },
];
---

<header
  data-hud
  class="pointer-events-none fixed inset-x-0 top-0 z-20 flex h-[68px] items-center justify-between bg-linear-to-b from-bg from-40% to-transparent px-5 desk:h-20 desk:bg-none desk:px-[calc(var(--ux)*44)]"
>
  <a
    href="#top"
    class="pointer-events-auto flex items-end gap-[5px] text-xl leading-none font-extrabold tracking-[-0.03em] text-ink desk:text-[22px]"
  >
    {initials}
    <span
      class="mb-0.5 block size-[7px] rounded-full bg-green"
      aria-hidden="true"
    ></span>
    <span class="sr-only">{portfolio.hero.displayName}</span>
  </a>

  <div class="pointer-events-auto flex items-center gap-1.5 desk:gap-9">
    <nav
      aria-label={ui.a11y.mainNavigation}
      class="mono-label hidden items-center gap-9 desk:flex"
    >
      {navLinks.map((link) => (
        <a href={link.href} class="text-soft hover:text-green">
          {link.label}
        </a>
      ))}
    </nav>
    <LanguageSwitch locale={locale} label={ui.a11y.languageSelector} />
    <div class="desk:hidden">
      <MobileMenu ui={ui} />
    </div>
  </div>
</header>

<div
  data-hud-rail
  aria-hidden="true"
  class="mono-label pointer-events-none fixed bottom-[calc(var(--u)*44)] left-[calc(var(--ux)*28)] z-20 hidden rotate-180 items-center gap-3.5 text-faint [writing-mode:vertical-rl] desk:flex"
>
  <span data-hud-rail-index class="text-green">
    {sceneIndex("top")}
  </span>
  <span class="block h-10 w-px bg-ink/20"></span>
  <span data-hud-rail-label>{ui.hero.eyebrow}</span>
</div>

<div
  data-hud-counter
  aria-hidden="true"
  class="pointer-events-none fixed right-[calc(var(--ux)*44)] bottom-[calc(var(--u)*48)] z-20 hidden items-center gap-3.5 desk:flex"
>
  <span data-hud-counter-text class="mono-label text-faint">
    {sceneIndex("top")} / {SCENE_TOTAL}
  </span>
  <span class="block h-px w-[120px] bg-ink/15">
    <span
      data-hud-progress
      class="block h-px bg-green"
      style={`width: ${initialProgress}%`}
    ></span>
  </span>
</div>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-hud-rail],
    [data-hud-counter] {
      display: none;
    }
  }
</style>
