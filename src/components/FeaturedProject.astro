---
import MediaPlaceholder from "./MediaPlaceholder.astro";
import { formatYearRange } from "../lib/dates";
import { desktopType, mobileType } from "../lib/fluidType";
import type { PortfolioViewModel } from "../lib/portfolio";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { portfolio, ui } = Astro.props;
const project = portfolio.featuredProject;
const yearRange =
  project.startDate &&
  formatYearRange(project.startDate, project.endDate, ui.experience.current);
---

<section
  id="featured"
  class="relative overflow-hidden px-5 py-24 lg:px-11 lg:py-32"
>
  <span
    aria-hidden="true"
    class="text-outline pointer-events-none absolute -top-10 right-0 hidden lg:block"
    style={`font-size:${desktopType(640)}; --stroke-color: color-mix(in srgb, var(--color-purple-hi) 35%, transparent); --stroke: 1.5px;`}
  >
    {project.index}
  </span>

  <div class="relative z-10 flex flex-col gap-4">
    <p class="mono-label text-green">
      {project.type}
      {yearRange && ` — ${yearRange}`}
    </p>
    <h3 class="display text-ink" style={`font-size:${mobileType(118)}`}>
      <span class="lg:hidden">{project.name}</span>
      <span class="hidden lg:inline" style={`font-size:${desktopType(160)}`}>
        {project.name}
      </span>
    </h3>
    <p class="font-serif max-w-2xl text-xl text-body italic lg:text-[32px]">
      {project.description}
    </p>

    <div class="mt-2 flex flex-wrap items-center gap-4">
      <span class="mono-label text-muted">{ui.featured.stackLabel}</span>
      {project.keywords.map((keyword) => (
        <span class="text-lg font-medium font-stretch-85% text-ink">
          {keyword}
        </span>
      ))}
    </div>

    <a
      href={project.url}
      target="_blank"
      rel="noopener"
      data-cursor="cta"
      class="group mt-4 flex flex-col gap-3"
    >
      <span class="flex items-center gap-3 text-3xl font-bold font-stretch-82% lg:text-5xl">
        {ui.featured.ctaVisit}
        <svg
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M7 17L17 7M8 7h9v9"
            stroke="var(--color-green)"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </span>
      <span class="block h-0.5 w-full bg-green"></span>
      <span class="mono-label text-soft">{project.urlDisplay}</span>
    </a>
  </div>

  <div class="relative z-10 mt-16 flex flex-wrap items-start gap-6 lg:mt-24">
    <MediaPlaceholder
      label={ui.featured.captionAdmin}
      dimensions="640×400"
      class="aspect-[16/10] w-full max-w-[520px] shadow-2xl"
    />
    <MediaPlaceholder
      label={ui.featured.captionLanding}
      dimensions="640×400"
      class="aspect-[16/10] w-full max-w-[320px] -mt-10 ml-auto shadow-2xl lg:mt-0"
    />
    <MediaPlaceholder
      label={ui.featured.captionMobile}
      dimensions="225×400"
      rounded
      class="aspect-[9/16] w-full max-w-[160px] shadow-2xl"
    />
  </div>
</section>
