---
import SceneEyebrow from "./SceneEyebrow.astro";
import SignalDot from "./SignalDot.astro";
import { formatIndex } from "../lib/portfolio";
import type { PortfolioViewModel } from "../lib/portfolio";
import {
  STACK_COLUMN_SIZES,
  fitsOneLine,
  stackColumnFontSize,
  stackColumnLoop,
} from "../lib/stack";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { portfolio, ui } = Astro.props;

/** Alto de medio escenario por encima/debajo de la línea de foco (u). */
const HALF_STAGE = 470;

const columns = portfolio.stack.groups.map((group, index) => {
  const designSize = STACK_COLUMN_SIZES[index % STACK_COLUMN_SIZES.length];
  const size = stackColumnFontSize(group.keywords, designSize);
  const rowsToFill = Math.ceil(HALF_STAGE / (size * 1.2)) + 1;
  return {
    ...group,
    count: formatIndex(group.keywords.length),
    size,
    loop: stackColumnLoop(group.keywords, rowsToFill + group.keywords.length),
    // Marquesina mobile: la lista repetida para cubrir el ancho y el desplazamiento.
    marquee: [...group.keywords, ...group.keywords, ...group.keywords],
  };
});
---

<section id="stack" data-scene-label={ui.stack.eyebrow} class="scene stack">
  <div class="stage">
    <div class="glow stack-glow" aria-hidden="true"></div>

    <SceneEyebrow
      scene="stack"
      label={ui.stack.eyebrow}
      as="p"
      class="eyebrow"
    />
    <h2 class="display title">{ui.stack.eyebrow}</h2>

    <div class="columns">
      {columns.map((column, columnIndex) => (
        <div
          class="column"
          style={`--size: ${column.size}; --col: ${columnIndex};`}
          data-count={column.keywords.length}
          data-motion="stack-column"
        >
          <h3 class="mono-label column-label">
            <span class="text-green" aria-hidden="true">
              {column.count}
            </span>
            <span class="text-soft">{column.name}</span>
          </h3>
          <ul class="canonical-list">
            {column.keywords.map((keyword) => (
              <li>{keyword}</li>
            ))}
          </ul>

          <div class="loop" aria-hidden="true" data-motion="stack-loop">
            <div class="loop-side loop-before">
              {column.loop.before.map((keyword, i, all) => (
                <span
                  class:list={[
                    "item",
                    i === all.length - 1 && "is-near",
                    !fitsOneLine(keyword, column.size) && "is-wrapped",
                  ]}
                >
                  {keyword}
                </span>
              ))}
            </div>
            <span
              class:list={[
                "item is-focus",
                !fitsOneLine(column.loop.focus, column.size) && "is-wrapped",
              ]}
            >
              {column.loop.focus}
            </span>
            <div class="loop-side">
              {column.loop.after.map((keyword, i) => (
                <span
                  class:list={[
                    "item",
                    i === 0 && "is-near",
                    !fitsOneLine(keyword, column.size) && "is-wrapped",
                  ]}
                >
                  {keyword}
                </span>
              ))}
            </div>
          </div>

          <div class="marquee" aria-hidden="true" data-motion="stack-marquee">
            {column.marquee.map((keyword, i) => (
              <>
                <span
                  class="marquee-item"
                  data-keyword-index={i % column.keywords.length}
                >
                  {keyword}
                </span>
                <span class="marquee-dot"></span>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mask mask-top" aria-hidden="true"></div>
    <div class="mask mask-bottom" aria-hidden="true"></div>
    <div class="focus-line" aria-hidden="true"></div>
    <SignalDot class="focus-dot" />
  </div>
</section>

<style>
  /* ---------- Mobile · escena narrativa entre EcuStock y prácticas ---------- */
  .stack {
    --stack-unit: min(var(--u), calc(100svh / 844));
    min-height: calc(var(--stack-unit) * 844);
    --seam-color: color-mix(in srgb, var(--color-purple) 6%, var(--color-bg));
    overflow: clip;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-purple) 10%, var(--color-bg)) 0%,
      transparent 18%,
      transparent 82%,
      color-mix(in srgb, var(--color-purple) 6%, var(--color-bg)) 100%
    );
  }

  .stage {
    height: calc(var(--stack-unit) * 844);
  }

  .stack-glow {
    left: calc(var(--ux) * -255);
    top: calc(var(--stack-unit) * -420);
    width: calc(var(--stack-unit) * 900);
    height: calc(var(--stack-unit) * 900);
    --glow-strength: 20%;
  }

  .stack :global(.eyebrow) {
    position: absolute;
    z-index: 6;
    left: calc(var(--ux) * 20);
    top: calc(var(--stack-unit) * 72);
  }

  .title {
    position: absolute;
    z-index: 3;
    left: calc(var(--ux) * 14);
    top: calc(var(--stack-unit) * 108);
    margin: 0;
    font-size: calc(var(--stack-unit) * 176);
    color: var(--color-ink);
  }

  .column {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    top: calc(var(--stack-unit) * (284 + var(--col) * 122));
    height: calc(var(--stack-unit) * 104);
  }

  .column-label {
    position: absolute;
    left: calc(var(--ux) * 20);
    top: 0;
    display: flex;
    gap: 10px;
    margin: 0;
  }

  .canonical-list {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .loop,
  .mask,
  .focus-line,
  .stack :global(.focus-dot) {
    display: none;
  }

  .marquee {
    position: absolute;
    top: calc(var(--stack-unit) * 26);
    left: calc(var(--ux) * var(--marquee-offset, -40));
    display: flex;
    align-items: center;
    gap: calc(var(--stack-unit) * 18);
    white-space: nowrap;
    will-change: transform;
  }

  .column:nth-child(4n + 2) .marquee {
    --marquee-offset: -260;
  }

  .column:nth-child(4n + 3) .marquee {
    --marquee-offset: -10;
  }

  .column:nth-child(4n + 4) .marquee {
    --marquee-offset: -150;
  }

  .marquee-item {
    font-family: var(--font-display);
    font-size: calc(var(--stack-unit) * 60);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    letter-spacing: -0.012em;
    color: transparent;
    -webkit-text-stroke: 1px
      color-mix(in srgb, var(--color-lilac) 26%, transparent);
    opacity: 0.72;
    transition:
      color 0.3s ease,
      opacity 0.3s ease,
      -webkit-text-stroke-color 0.3s ease;
  }

  .marquee-item.is-near {
    -webkit-text-stroke-color: color-mix(
      in srgb,
      var(--color-lilac) 58%,
      transparent
    );
    opacity: 1;
  }

  .marquee-item.is-focus {
    color: var(--color-ink);
    -webkit-text-stroke-color: transparent;
    opacity: 1;
  }

  .marquee-dot {
    flex-shrink: 0;
    width: calc(var(--stack-unit) * 9);
    height: calc(var(--stack-unit) * 9);
    border-radius: 9999px;
    background: var(--color-green);
    opacity: 0.58;
  }

  .marquee-item.is-focus + .marquee-dot {
    opacity: 1;
  }

  /* El escenario permanece en pantalla mientras las cuatro filas progresan. */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1023px),
    (prefers-reduced-motion: no-preference) and (orientation: portrait) {
    :global(html.motion) .stack {
      height: max(calc(var(--stack-unit) * 2800), 340svh);
    }

    :global(html.motion) .stage {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }

  /* Sin movimiento, la fuente canónica se presenta una sola vez y en wrap. */
  @media (prefers-reduced-motion: reduce) and (max-width: 1023px),
    (prefers-reduced-motion: reduce) and (orientation: portrait) {
    .stack {
      height: auto;
      min-height: calc(var(--stack-unit) * 844);
    }

    .stage {
      height: auto;
      min-height: calc(var(--stack-unit) * 844);
    }

    .columns {
      display: grid;
      gap: calc(var(--stack-unit) * 30);
      padding: calc(var(--stack-unit) * 292) calc(var(--ux) * 20)
        calc(var(--stack-unit) * 72);
    }

    .column {
      position: relative;
      inset: auto;
      height: auto;
    }

    .column-label {
      position: relative;
      left: auto;
      top: auto;
    }

    .canonical-list {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: calc(var(--stack-unit) * 8) calc(var(--ux) * 16);
      width: auto;
      height: auto;
      margin: calc(var(--stack-unit) * 12) 0 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      list-style: none;
    }

    .canonical-list li {
      display: inline-flex;
      align-items: center;
      gap: calc(var(--ux) * 8);
      font-family: var(--font-display);
      font-size: calc(var(--stack-unit) * 29);
      font-weight: 750;
      font-stretch: 75%;
      line-height: 1;
      letter-spacing: -0.012em;
      color: var(--color-ink);
    }

    .canonical-list li::after {
      width: calc(var(--stack-unit) * 5);
      height: calc(var(--stack-unit) * 5);
      border-radius: 9999px;
      background: var(--color-green);
      content: "";
      opacity: 0.7;
    }

    .marquee {
      display: none;
    }
  }

  /* ---------- Desktop · artboard 07 (1440×900) ---------- */
  @media (min-width: 1024px) and (min-aspect-ratio: 1/1) {
    .stack {
      height: 100svh;
      overflow: hidden;
    }

    .stage {
      height: calc(var(--u) * 900);
    }

    .stack-glow {
      left: calc(var(--ux) * 500);
      top: calc(var(--u) * 150);
      width: calc(var(--u) * 800);
      height: calc(var(--u) * 800);
      --glow-strength: 22%;
    }

    .stack :global(.eyebrow) {
      display: none;
    }

    .title {
      z-index: 6;
      left: calc(var(--ux) * 72);
      top: 0;
      display: flex;
      align-items: center;
      height: 100%;
      font-size: calc(var(--u) * 210);
      writing-mode: vertical-rl;
      rotate: 180deg;
    }

    .column {
      z-index: auto;
      left: calc(var(--ux) * (240 + var(--col) * 300));
      right: auto;
      top: 0;
      width: calc(var(--ux) * 300);
      height: 100%;
      border-left: 1px solid
        color-mix(in srgb, var(--color-ink) 8%, transparent);
    }

    .column-label {
      z-index: 5;
      left: calc(var(--u) * 24);
      top: calc(var(--u) * 112);
    }

    .marquee {
      display: none;
    }

    .loop {
      position: absolute;
      inset: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
      padding: calc(var(--u) * 38) 0 0 calc(var(--u) * 24);
    }

    .loop-side {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .loop-before {
      justify-content: flex-end;
    }

    .item {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      width: calc(var(--u) * 270);
      min-height: calc(var(--u) * var(--size) * 1.2);
      font-family: var(--font-display);
      font-size: calc(var(--u) * var(--size));
      font-weight: 800;
      font-stretch: 75%;
      line-height: 0.95;
      letter-spacing: -0.012em;
      text-wrap: balance;
      color: transparent;
      -webkit-text-stroke: 1px
        color-mix(in srgb, var(--color-lilac) 16%, transparent);
      transition:
        color 0.35s ease,
        -webkit-text-stroke-color 0.35s ease;
    }

    .item.is-wrapped {
      padding-block: calc(var(--u) * var(--size) * 0.22);
    }

    .item.is-near {
      -webkit-text-stroke-color: color-mix(
        in srgb,
        var(--color-lilac) 40%,
        transparent
      );
    }

    .item.is-focus {
      color: var(--color-ink);
      -webkit-text-stroke: 0;
    }

    .mask {
      position: absolute;
      z-index: 4;
      left: calc(var(--ux) * 240);
      right: 0;
      display: block;
      height: calc(var(--u) * 230);
      pointer-events: none;
    }

    .mask-top {
      top: 0;
      background: linear-gradient(var(--color-bg) 45%, transparent);
    }

    .mask-bottom {
      bottom: 0;
      background: linear-gradient(transparent, var(--color-bg) 60%);
    }

    .focus-line {
      position: absolute;
      z-index: 5;
      left: calc(var(--ux) * 226);
      right: 0;
      top: calc(var(--u) * 469);
      display: block;
      height: 1px;
      background: linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-green) 70%, transparent),
        color-mix(in srgb, var(--color-green) 5%, transparent)
      );
    }

    .stack :global(.focus-dot) {
      position: absolute;
      z-index: 6;
      left: calc(var(--ux) * 226 - var(--u) * 22);
      top: calc(var(--u) * 448);
      display: inline-flex;
      width: calc(var(--u) * 44);
      height: calc(var(--u) * 44);
      --dot: calc(var(--u) * 14);
    }
  }
</style>
