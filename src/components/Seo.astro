---
import {
  alternateLinks,
  canonicalUrl,
  ogLocale,
  personJsonLd,
} from "../lib/seo";
import type { Locale } from "../lib/resume";

/**
 * Metadata común a toda página: canonical, hreflang, Open Graph,
 * Twitter Card y JSON-LD (schema.org/Person). `noindex` se usa en las
 * páginas de resultado del formulario y en la 404.
 */
export interface Props {
  title: string;
  description: string;
  locale: Locale;
  noindex?: boolean;
}

const { title, description, locale, noindex = false } = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://kevintarqui.vercel.app/";
const canonical = canonicalUrl(siteUrl, locale);
const alternates = alternateLinks(siteUrl);
const ogImage = new URL("/og-image.png", siteUrl).toString();
const jsonLd = personJsonLd(siteUrl, locale);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((alternate) => (
  <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
))}
{noindex && <meta name="robots" content="noindex" />}

<meta name="theme-color" content="#0b0812" />
<meta name="color-scheme" content="dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="profile" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale(locale)} />
{alternates
  .filter(
    (alternate) =>
      alternate.hreflang !== locale && alternate.hreflang !== "x-default",
  )
  .map((alternate) => (
    <meta
      property="og:locale:alternate"
      content={ogLocale(alternate.hreflang as Locale)}
    />
  ))}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
></script>
