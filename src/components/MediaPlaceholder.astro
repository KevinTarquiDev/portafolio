---
/**
 * Placeholder para capturas de proyectos que todavía no existen en el
 * repositorio (ver IMPLEMENTATION_PLAN.md, riesgo #2). Cuando la
 * captura real esté disponible en src/assets/projects/, se reemplaza
 * por <Picture> con avif/webp — nunca se inventa un screenshot.
 */
export interface Props {
  label: string;
  dimensions: string;
  class?: string;
}

const { label, dimensions, class: className = "" } = Astro.props;
---

<div
  class:list={["placeholder-hatch media-placeholder", className]}
  role="img"
  aria-label={`${label} — placeholder, captura pendiente`}
>
  <span class="mono-label text-lilac">{label}</span>
  <span class="mono-label text-muted">Placeholder · {dimensions}</span>
</div>

<style>
  .media-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
  }

  .media-placeholder span:first-child {
    font-size: 11px;
  }

  .media-placeholder span:last-child {
    font-size: 10px;
  }
</style>
