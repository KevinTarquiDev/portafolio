---
import { desktopType, mobileType } from "../lib/fluidType";
import type { PortfolioViewModel } from "../lib/portfolio";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { portfolio, ui } = Astro.props;
const entries = portfolio.education.items;
---

<section
  id="education"
  data-scene-label={ui.education.eyebrow}
  class="relative overflow-hidden px-5 py-24 lg:px-11 lg:py-32"
>
  <h2 class="mono-label mb-10 text-green">{ui.education.eyebrow}</h2>

  {entries.map((entry) => (
    <div class="mb-12 flex flex-col gap-8 last:mb-0 lg:gap-12">
      <div class="flex items-center gap-6">
        <span
          class="display text-lilac"
          style={`font-size:${mobileType(140)}; font-weight:200;`}
        >
          <span class="lg:hidden">{entry.startDate.slice(0, 4)}</span>
          <span
            class="hidden lg:inline"
            style={`font-size:${desktopType(250)}`}
          >
            {entry.startDate.slice(0, 4)}
          </span>
        </span>
        {entry.endDate && (
          <span
            data-motion="timeline-line"
            class="hidden h-px flex-1 bg-gradient-to-r from-lilac/30 to-green lg:block"
          />
        )}
        <span class="display text-ink" style={`font-size:${mobileType(140)}`}>
          <span class="lg:hidden">
            {entry.endDate ? entry.endDate.slice(0, 4) : ui.experience.current}
          </span>
          <span
            class="hidden lg:inline"
            style={`font-size:${desktopType(250)}`}
          >
            {entry.endDate ? entry.endDate.slice(0, 4) : ui.experience.current}
          </span>
        </span>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="display text-ink" style={`font-size:${mobileType(56)}`}>
          <span class="lg:hidden">{entry.area}</span>
          <span class="hidden lg:inline" style={`font-size:${desktopType(88)}`}>
            {entry.area}
          </span>
        </h3>
        <p
          class="font-serif text-lilac italic"
          style={`font-size:${mobileType(30)}`}
        >
          <span class="lg:hidden">{entry.institution}</span>
          <span class="hidden lg:inline" style={`font-size:${desktopType(46)}`}>
            {entry.institution}
          </span>
        </p>
        {entry.status && (
          <span class="mono-label mt-2 inline-flex w-fit items-center gap-2.5 rounded-full border border-green/45 px-4 py-2.5 text-ink">
            <span
              class="block h-2 w-2 rounded-full bg-green"
              aria-hidden="true"
            />
            {entry.status}
          </span>
        )}
      </div>
    </div>
  ))}
</section>
