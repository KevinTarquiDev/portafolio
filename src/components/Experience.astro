---
import SceneEyebrow from "./SceneEyebrow.astro";
import SignalDot from "./SignalDot.astro";
import { formatYearRange, parseResumeDate } from "../lib/dates";
import { formatIndex } from "../lib/portfolio";
import type { PortfolioViewModel } from "../lib/portfolio";
import type { UiStrings } from "../i18n/ui";

export interface Props {
  portfolio: PortfolioViewModel;
  ui: UiStrings;
}

const { portfolio, ui } = Astro.props;
const total = formatIndex(portfolio.experience.items.length);

const items = portfolio.experience.items.map((item) => {
  const startYear = String(parseResumeDate(item.startDate).year);
  const endYear = item.endDate
    ? String(parseResumeDate(item.endDate).year)
    : undefined;
  return {
    ...item,
    startYear,
    endYear,
    range: formatYearRange(item.startDate, item.endDate, ui.experience.current),
    compactRange:
      endYear === undefined
        ? `${startYear}–`
        : startYear === endYear
          ? startYear
          : `${startYear}–${endYear}`,
  };
});

const active = items[0];
if (!active) {
  throw new Error("El resume no tiene experiencia laboral que mostrar");
}
---

<section
  id="experience"
  data-scene-label={ui.experience.eyebrow}
  class="scene experience"
  style={`--rows: ${items.length};`}
>
  <div class="stage">
    <div class="glow experience-glow" aria-hidden="true"></div>
    <span
      class="display ghost"
      aria-hidden="true"
      data-motion="experience-ghost"
    >
      {active.company.short.toUpperCase()}
    </span>

    <SceneEyebrow
      scene="experience"
      label={ui.experience.eyebrow}
      class="eyebrow"
    />
    <p class="display mobile-title" aria-hidden="true">
      {ui.experience.eyebrow}
    </p>

    {/* Desktop: años gigantes y detalle del puesto activo (lo cambia motion.ts) */}
    <div class="years" aria-hidden="true" data-motion="experience-years">
      <span class="display year-start" data-motion="experience-year-start">
        {active.startYear}
      </span>
      <span
        class:list={[
          "display text-outline year-end",
          !active.endYear && "is-label",
        ]}
        data-motion="experience-year-end"
      >
        {active.endYear ?? ui.experience.current}
      </span>
    </div>

    <div class="detail" aria-hidden="true" data-motion="experience-detail">
      <span
        class="mono-label text-muted detail-index"
        data-motion="experience-detail-index"
      >
        {active.index} / {total}
        {active.isCurrent && ` — ${ui.experience.current}`}
      </span>
      <span
        class="display detail-company"
        data-motion="experience-detail-company"
      >
        {active.company.short}
      </span>
      <span
        class="serif detail-position"
        data-motion="experience-detail-position"
      >
        {active.position}
      </span>
    </div>

    <ol class="jobs">
      {items.map((item, index) => (
        <li
          class:list={["job", index === 0 && "is-active"]}
          data-motion="experience-job"
          data-start={item.startYear}
          data-end={item.endYear ?? ui.experience.current}
          data-company={item.company.short}
          data-position={item.position}
          data-detail-index={`${item.index} / ${total}${item.isCurrent ? ` — ${ui.experience.current}` : ""}`}
        >
          <span class="display job-years" aria-hidden="true">
            {item.compactRange}
          </span>
          <div class="job-body">
            <span class="mono-label job-index">
              {item.index}
              <span class="job-total"> / {total}</span>
            </span>
            <h3 class="job-company">{item.company.short}</h3>
            <p class="job-position">{item.position}</p>
            <p class="mono-label job-range">{item.range}</p>
          </div>
          <span class="job-dot" aria-hidden="true"></span>
        </li>
      ))}
    </ol>

    <span class="rail" aria-hidden="true">
      <span class="rail-active" data-motion="experience-rail-active"></span>
    </span>
    <SignalDot class="rail-dot" data-motion="experience-dot" />
  </div>
</section>

<style>
  /* ---------- Mobile · timeline vertical narrativa ligada al scroll ---------- */
  .experience {
    height: auto;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-purple) 4%, var(--color-bg)) 0%,
      transparent 16%,
      transparent 88%,
      color-mix(in srgb, var(--color-purple) 3%, var(--color-bg)) 100%
    );
  }

  .stage {
    height: auto;
    padding-top: calc(var(--u) * 250);
  }

  .experience-glow {
    left: calc(var(--ux) * -100);
    top: calc(var(--u) * 200);
    width: calc(var(--u) * 700);
    height: calc(var(--u) * 700);
    --glow-strength: 26%;
  }

  .ghost,
  .years,
  .detail,
  .rail,
  .experience :global(.rail-dot),
  .job-range {
    display: none;
  }

  .experience :global(.eyebrow) {
    position: absolute;
    z-index: 6;
    left: calc(var(--ux) * 20);
    top: calc(var(--u) * 96);
  }

  .mobile-title {
    position: absolute;
    z-index: 3;
    left: calc(var(--ux) * 14);
    top: calc(var(--u) * 130);
    margin: 0;
    font-size: calc(var(--u) * 92);
    white-space: nowrap;
    color: var(--color-ink);
  }

  .jobs {
    position: relative;
    z-index: 3;
    left: 0;
    right: 0;
    top: auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jobs::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: calc(var(--u) * 36);
    right: calc(var(--ux) * 25);
    bottom: calc(var(--u) * 36);
    width: 1px;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--color-green) 35%, transparent) 10%,
      color-mix(in srgb, var(--color-green) 18%, transparent) 90%,
      transparent
    );
  }

  .job {
    position: relative;
    display: flex;
    min-height: calc(var(--u) * 260);
  }

  .job-years {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: calc(var(--u) * 96);
    font-size: calc(var(--u) * 64);
    line-height: 1;
    white-space: nowrap;
    writing-mode: vertical-rl;
    rotate: 180deg;
    color: transparent;
    -webkit-text-stroke: 1px
      color-mix(in srgb, var(--color-lilac) 30%, transparent);
    transition:
      color 0.35s ease,
      -webkit-text-stroke-color 0.35s ease,
      opacity 0.35s ease;
    opacity: 0.7;
  }

  .is-active .job-years {
    color: var(--color-ink);
    -webkit-text-stroke: 0;
    opacity: 1;
  }

  .job-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--u) * 10);
    padding: 0 calc(var(--ux) * 52) 0 calc(var(--u) * 8);
    opacity: 0.8;
    transition: opacity 0.35s ease;
  }

  .is-active .job-body {
    opacity: 1;
  }

  .job-index {
    color: var(--color-muted);
    transition: color 0.35s ease;
  }

  .is-active .job-index {
    color: var(--color-green);
  }

  .job-company {
    margin: 0;
    font-family: var(--font-display);
    font-size: calc(var(--u) * 44);
    font-weight: 700;
    font-stretch: 75%;
    line-height: 0.95;
    letter-spacing: -0.012em;
    color: var(--color-soft);
    transition: color 0.35s ease;
  }

  .is-active .job-company {
    color: var(--color-ink);
  }

  .job-position {
    margin: 0;
    font-family: var(--font-serif);
    font-size: calc(var(--u) * 26);
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--color-lilac) 68%, transparent);
    transition: color 0.35s ease;
  }

  .is-active .job-position {
    color: var(--color-lilac);
  }

  .job-dot {
    position: absolute;
    z-index: 2;
    right: calc(var(--ux) * 20);
    top: 50%;
    width: calc(var(--u) * 10);
    height: calc(var(--u) * 10);
    translate: 0 -50%;
    border: 1px solid color-mix(in srgb, var(--color-green) 68%, transparent);
    border-radius: 9999px;
    background: var(--color-bg);
    transition:
      scale 0.35s ease,
      border-color 0.35s ease,
      background-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .is-active .job-dot {
    scale: 1.45;
    border-color: var(--color-green);
    background: var(--color-green);
    box-shadow: 0 0 22px color-mix(in srgb, var(--color-green) 52%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .job {
      min-height: calc(var(--u) * 270);
    }

    .job-years {
      color: var(--color-ink);
      -webkit-text-stroke: 0;
      opacity: 1;
    }

    .job-body {
      opacity: 1;
    }

    .job-index {
      color: var(--color-green);
    }

    .job-company {
      color: var(--color-ink);
    }

    .job-position {
      color: var(--color-lilac);
    }

    .job-dot {
      border-color: color-mix(in srgb, var(--color-green) 75%, transparent);
    }
  }

  /* ---------- Desktop · artboard 03 (1440×900) ---------- */
  @media (min-width: 1024px) and (min-aspect-ratio: 1/1) {
    .experience {
      height: 100svh;
    }

    .stage {
      height: calc(var(--u) * 900);
      padding-top: 0;
    }

    .experience-glow {
      left: calc(var(--ux) * 900);
      top: calc(var(--u) * -200);
      width: calc(var(--u) * 900);
      height: calc(var(--u) * 900);
      --glow-strength: 28%;
    }

    .mobile-title,
    .job-years,
    .job-total,
    .job-dot {
      display: none;
    }

    .ghost {
      position: absolute;
      z-index: 1;
      left: calc(var(--ux) * -30);
      top: calc(var(--u) * 690);
      display: block;
      font-size: calc(var(--u) * 290);
      white-space: nowrap;
      color: color-mix(in srgb, var(--color-purple) 14%, transparent);
    }

    .experience :global(.eyebrow) {
      left: calc(var(--ux) * 104);
      top: calc(var(--u) * 124);
    }

    .years {
      position: absolute;
      z-index: 3;
      left: calc(var(--ux) * 92);
      top: calc(var(--u) * 160);
      display: flex;
      flex-direction: column;
    }

    .year-start,
    .year-end {
      font-size: calc(var(--u) * 330);
      color: var(--color-ink);
    }

    .year-end {
      margin-top: calc(var(--u) * 14);
      color: transparent;
      --stroke: 1.5px;
      --stroke-color: var(--color-lilac);
    }

    .year-end.is-label {
      font-size: calc(var(--u) * 150);
    }

    .detail {
      position: absolute;
      z-index: 4;
      left: calc(var(--ux) * 830);
      top: calc(var(--u) * 150);
      display: flex;
      flex-direction: column;
      gap: calc(var(--u) * 18);
      width: calc(var(--u) * 520);
    }

    .detail-company {
      font-size: calc(var(--u) * 96);
      font-weight: 700;
      line-height: 0.9;
      color: var(--color-ink);
    }

    .detail-position {
      font-size: calc(var(--u) * 46);
      line-height: 1;
      color: var(--color-lilac);
    }

    .jobs {
      position: absolute;
      z-index: 4;
      left: calc(var(--ux) * 830);
      right: auto;
      top: calc(var(--u) * 490);
      width: calc(var(--u) * 560);
    }

    .jobs::before {
      display: none;
    }

    .job {
      display: block;
      height: calc(var(--u) * 58);
      min-height: 0;
      color: var(--color-muted);
      transition:
        color 0.4s ease,
        border-color 0.4s ease;
    }

    .job.is-active {
      color: var(--color-ink);
    }

    .job-body {
      display: grid;
      grid-template-columns:
        calc(var(--u) * 36) minmax(0, 1fr) calc(var(--u) * 150)
        calc(var(--u) * 104);
      align-items: center;
      gap: calc(var(--u) * 12);
      height: 100%;
      padding: 0;
      opacity: 1;
    }

    .job-index {
      color: var(--color-muted);
    }

    .job-company {
      font-size: calc(var(--u) * 23);
      font-weight: 600;
      font-stretch: 78%;
      line-height: 1;
      letter-spacing: -0.01em;
      white-space: nowrap;
      color: inherit;
    }

    .job-position {
      font-family: var(--font-mono);
      font-size: 10px;
      font-style: normal;
      line-height: 1.4;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: inherit;
    }

    .job-range {
      display: block;
      text-align: right;
      white-space: nowrap;
      color: inherit;
    }

    .rail {
      position: absolute;
      z-index: 4;
      left: calc(var(--ux) * 800);
      top: calc(var(--u) * 490);
      display: block;
      width: 1px;
      height: calc(var(--u) * 58 * var(--rows));
      background: color-mix(in srgb, var(--color-ink) 12%, transparent);
    }

    .rail-active {
      display: block;
      width: 1px;
      height: calc(var(--u) * 58);
      background: var(--color-green);
    }

    .experience :global(.rail-dot) {
      position: absolute;
      z-index: 6;
      left: calc(var(--ux) * 800 - var(--u) * 21);
      top: calc(var(--u) * 497);
      display: inline-flex;
      width: calc(var(--u) * 44);
      height: calc(var(--u) * 44);
      --dot: calc(var(--u) * 14);
    }
  }
</style>
