{
  "name": "portafolio-pro",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun run cv:generate && astro dev",
    "build": "bun run cv:generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "cv:generate": "bun scripts/generate-cv.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "resume:validate": "bun scripts/validate-resume.ts",
    "prepare": "husky",
    "test": "bun test",
    "build:check": "bun scripts/check-build.ts",
    "secrets:check": "bun scripts/check-secrets.ts",
    "fix": "bun run format && bun run check",
    "verify": "bun run format:check && bun run resume:validate && bun run test && bun run check && bun run build && bun run build:check && bun run secrets:check --allow-missing"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@jsonresume/schema": "1.3.1",
    "@types/bun": "^1.4.2",
    "@types/pdfkit": "^0.17.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "6.0.3"
  }
}
